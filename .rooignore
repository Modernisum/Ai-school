# .rooignore - Files to exclude from code indexing to reduce GPU load
# This file follows .gitignore syntax patterns

# ============ BUILD OUTPUTS & DEPENDENCIES ============

# Node.js dependencies
**/node_modules/
**/package-lock.json
**/yarn.lock
**/pnpm-lock.yaml

# Flutter/Pub dependencies
**/.dart_tool/
**/.pub-cache/
**/pubspec.lock
**/build/
**/.flutter-plugins
**/.flutter-plugins-dependencies

# Rust dependencies
**/target/
**/Cargo.lock

# Python dependencies
**/__pycache__/
**/.pytest_cache/
**/.venv/
**/venv/
**/env/
**/virtualenv/

# ============ GENERATED FILES ============

# Flutter generated
**/generated_plugin_registrant.*
**/*.g.dart
**/*.freezed.dart
**/*.gr.dart

# Build outputs
**/dist/
**/out/
**/build/
**/.build/
**/*.o
**/*.obj
**/*.exe
**/*.dll
**/*.so
**/*.dylib

# IDE files
**/.vscode/
**/.idea/
**/*.iml
**/.project
**/.classpath
**/.settings/

# ============ LARGE DATA FILES ============
**/Backup/
**/*.backup
**/*.bak

# Database files
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.mdb

# Log files
**/*.log
**/logs/
**/log/

# Cache files
**/.cache/
**/*.cache

# ============ MEDIA & BINARY FILES ============

# Images
**/*.png
**/*.jpg
**/*.jpeg
**/*.gif
**/*.bmp
**/*.ico
**/*.svg
**/*.webp

# Videos
**/*.mp4
**/*.avi
**/*.mov
**/*.mkv

# Audio
**/*.mp3
**/*.wav
**/*.ogg

# Documents
**/*.pdf
**/*.doc
**/*.docx
**/*.xls
**/*.xlsx
**/*.ppt
**/*.pptx

# Archives
**/*.zip
**/*.tar
**/*.gz
**/*.7z
**/*.rar

# Configuration files (already handled by rules)
**/config/
**/configuration/

# ============ TEST & MOCK DATA ============

# Test data
**/test_data/
**/fixtures/
**/mocks/

# Coverage reports
**/coverage/
**/.coverage
**/*.lcov

# ============ TEMPORARY FILES ============

# OS temporary files
**/.DS_Store
**/Thumbs.db
**/desktop.ini

# Editor temporary files
**/*.swp
**/*.swo
**/*~
**/\#*#
**/.#*
**/*.bin
**/*.pt
**/*.pth
**/*.h5
**/*.onnx

# Vector database files
**/.qdrant/
**/vector_store/

# Docker/Container files
**/.dockerignore
**/Dockerfile
**/docker-compose*.yml

# Documentation (already in .ai-docs)
**/docs/
**/documentation/

# ============ SPECIFIC FILE PATTERNS ============

# Minified/compressed files
**/*.min.js
**/*.min.css
**/*.min.dart.js

# Source maps
**/*.map

# License files (except root)
**/LICENSE*
**/license*
**/COPYING*

# Readme files (except root and important ones)
**/README*
**/readme*

# ============ GIT & VERSION CONTROL ============

# Git files
**/.git/
**/.gitignore
**/.gitattributes
**/.gitmodules
