{
  "version": "1",
  "name": "Modern School API Test Environment",
  "type": "environment",
  "variables": [
    {
      "name": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "name": "schoolId",
      "value": "1"
    },
    {
      "name": "adminToken",
      "value": "{{LOGIN_RESPONSE:admin_token}}",
      "description": "Obtained via admin login, will be set dynamically"
    },
    {
      "name": "apiKey",
      "value": "test_api_key_123",
      "description": "API key for public developer API"
    },
    {
      "name": "studentId",
      "value": "STU001",
      "description": "Sample student ID for testing"
    },
    {
      "name": "employeeId",
      "value": "EMP001",
      "description": "Sample employee ID for testing"
    },
    {
      "name": "leaveId",
      "value": "LEAVE001",
      "description": "Sample leave ID for testing"
    },
    {
      "name": "responsibilityId",
      "value": "RESP001",
      "description": "Sample responsibility ID for testing"
    },
    {
      "name": "materialName",
      "value": "Textbook",
      "description": "Sample material name for testing"
    },
    {
      "name": "spaceName",
      "value": "Classroom-101",
      "description": "Sample space name for testing"
    },
    {
      "name": "holidayId",
      "value": "HOL001",
      "description": "Sample holiday ID for testing"
    },
    {
      "name": "taskId",
      "value": "TASK001",
      "description": "Sample task ID for testing"
    },
    {
      "name": "webhookId",
      "value": "WEBHOOK001",
      "description": "Sample webhook ID for testing"
    },
    {
      "name": "configId",
      "value": "CONFIG001",
      "description": "Sample config ID for testing"
    },
    {
      "name": "promoId",
      "value": "PROMO001",
      "description": "Sample promo ID for testing"
    },
    {
      "name": "couponId",
      "value": "COUPON001",
      "description": "Sample coupon ID for testing"
    },
    {
      "name": "feeId",
      "value": "FEE001",
      "description": "Sample fee ID for testing"
    },
    {
      "name": "developerId",
      "value": "DEV001",
      "description": "Sample developer ID for testing"
    },
    {
      "name": "requestId",
      "value": "REQ001",
      "description": "Sample request ID for testing"
    },
    {
      "name": "summaryId",
      "value": "SUM001",
      "description": "Sample summary ID for testing"
    },
    {
      "name": "countryId",
      "value": "1",
      "description": "Sample country ID for geo routes"
    },
    {
      "name": "stateId",
      "value": "1",
      "description": "Sample state ID for geo routes"
    },
    {
      "name": "date",
      "value": "2024-01-15",
      "description": "Sample date for attendance routes"
    },
    {
      "name": "startDate",
      "value": "2024-01-01",
      "description": "Sample start date for reports"
    },
    {
      "name": "endDate",
      "value": "2024-01-31",
      "description": "Sample end date for reports"
    },
    {
      "name": "role",
      "value": "student",
      "description": "Sample role for attendance routes"
    },
    {
      "name": "userId",
      "value": "USER001",
      "description": "Sample user ID for testing"
    },
    {
      "name": "userType",
      "value": "school-admin",
      "description": "Sample user type for auth routes"
    },
    {
      "name": "vehicleId",
      "value": "VEH001",
      "description": "Sample vehicle ID for transport routes"
    },
    {
      "name": "class_name",
      "value": "10",
      "description": "Sample class name for student routes"
    },
    {
      "name": "type",
      "value": "announcement",
      "description": "Sample type for announcement routes"
    }
  ]
}