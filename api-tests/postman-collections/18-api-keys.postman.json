{
  "info": {
    "name": "API Key Management APIs",
    "description": "Converted from 18-api-keys.bru",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Generate API Key",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "X-School-ID",
            "value": "{{schoolId}}",
            "type": "text"
          },
          {
            "key": "X-Admin-ID",
            "value": "{{adminId}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/school/{{schoolId}}/api-keys",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "{{baseUrl}}",
            "api",
            "school",
            "{{schoolId}}",
            "api-keys"
          ],
          "query": []
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test API Key\",\n  \"scopes\": [\"students:read\", \"attendance:write\"]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": ""
      },
      "response": []
    },
    {
      "name": "2. List API Keys",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-School-ID",
            "value": "{{schoolId}}",
            "type": "text"
          },
          {
            "key": "X-Admin-ID",
            "value": "{{adminId}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/school/{{schoolId}}/api-keys",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "{{baseUrl}}",
            "api",
            "school",
            "{{schoolId}}",
            "api-keys"
          ],
          "query": []
        },
        "description": ""
      },
      "response": []
    },
    {
      "name": "3. Revoke API Key",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-School-ID",
            "value": "{{schoolId}}",
            "type": "text"
          },
          {
            "key": "X-Admin-ID",
            "value": "{{adminId}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/school/{{schoolId}}/api-keys/{{generatedKeyId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "{{baseUrl}}",
            "api",
            "school",
            "{{schoolId}}",
            "api-keys",
            "{{generatedKeyId}}"
          ],
          "query": []
        },
        "description": ""
      },
      "response": []
    },
    {
      "name": "4. Verify API Key Authentication (Middleware Test)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{generatedApiKey}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/school/{{schoolId}}/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "{{baseUrl}}",
            "api",
            "school",
            "{{schoolId}}",
            "students"
          ],
          "query": []
        },
        "description": ""
      },
      "response": []
    },
    {
      "name": "5. Test Invalid API Key",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "vk_invalid_key_1234567890abcdef",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/school/{{schoolId}}/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "{{baseUrl}}",
            "api",
            "school",
            "{{schoolId}}",
            "students"
          ],
          "query": []
        },
        "description": ""
      },
      "response": []
    }
  ]
}