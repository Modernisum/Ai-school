    {
      "name": "1. Generate API Key for Testing",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "X-School-ID",
            "value": "{{schoolId}}",
            "type": "text"
          },
          {
            "key": "X-Admin-ID",
            "value": "{{adminId}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/school/{{schoolId}}/api-keys",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "{{baseUrl}}",
            "api",
            "school",
            "{{schoolId}}",
            "api-keys"
          ],
          "query": []
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Public API Test Key\",\n  \"scopes\": [\"read:students\", \"read:attendance\"]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": ""
      },
      "response": []
    },
