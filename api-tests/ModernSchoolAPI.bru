{
  "version": "1",
  "name": "Modern School API Tests",
  "type": "collection",
  "items": [
    {
      "name": "Health Check",
      "type": "request",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "responses": []
    },
    {
      "name": "AI Query",
      "type": "request",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/ai/:schoolId/query",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"query\": \"What is the capital of India?\",\n  \"provider\": \"gemini\"\n}"
        }
      },
      "responses": []
    },
    {
      "name": "List Students",
      "type": "request",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/students/:schoolId",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "responses": []
    },
    {
      "name": "List Students Paginated",
      "type": "request",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/students/:schoolId/paginated?page=1&limit=20",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "responses": []
    },
    {
      "name": "List Students Paginated - Filter by Class",
      "type": "request",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/students/:schoolId/paginated?page=1&limit=20&class_name=10",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "responses": []
    },
    {
      "name": "List Students Paginated - Filter by Status",
      "type": "request",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/students/:schoolId/paginated?page=1&limit=20&status=active",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "responses": []
    },
    {
      "name": "List Students Paginated - Search",
      "type": "request",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/students/:schoolId/paginated?page=1&limit=20&search=John",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "responses": []
    }
  ],
  "environments": [
    {
      "name": "Development",
      "variables": [
        {
          "name": "baseUrl",
          "value": "http://localhost:8080"
        },
        {
          "name": "schoolId",
          "value": "1"
        }
      ]
    }
  ]
}