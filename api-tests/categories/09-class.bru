{
  "version": "1",
  "name": "Class & Subject Management APIs",
  "type": "collection",
  "items": [
    {
      "name": "1. Create Class",
      "type": "http-request",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/class/{{schoolId}}",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          },
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"className\": \"Class 10-A\",\n  \"section\": \"A\",\n  \"academicYear\": \"2024-2025\",\n  \"classTeacherId\": \"{{sampleEmployeeId}}\",\n  \"maxStudents\": 40,\n  \"subjects\": [\"Mathematics\", \"Science\", \"English\", \"Social Studies\"],\n  \"description\": \"Class 10 Section A for academic year 2024-2025\"\n}"
        }
      }
    },
    {
      "name": "2. List Classes",
      "type": "http-request",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/class/{{schoolId}}",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          }
        ]
      }
    },
    {
      "name": "3. Create Subject",
      "type": "http-request",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/subject/{{schoolId}}",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          },
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"subjectName\": \"Computer Science\",\n  \"subjectCode\": \"CS101\",\n  \"description\": \"Introduction to Computer Science\",\n  \"credits\": 4,\n  \"isElective\": true,\n  \"applicableClasses\": [\"Class 10\", \"Class 11\", \"Class 12\"],\n  \"teacherId\": \"{{sampleEmployeeId}}\"\n}"
        }
      }
    },
    {
      "name": "4. List Subjects",
      "type": "http-request",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/subject/{{schoolId}}",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          }
        ]
      }
    },
    {
      "name": "5. Assign Subject to Class",
      "type": "http-request",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/class/{{schoolId}}/{{sampleClassId}}/subjects",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          },
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"subjectIds\": [\"{{sampleSubjectId}}\"],\n  \"weeklyPeriods\": 5,\n  \"teacherId\": \"{{sampleEmployeeId}}\"\n}"
        }
      }
    },
    {
      "name": "6. Get Class Subjects",
      "type": "http-request",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/class/{{schoolId}}/{{sampleClassId}}/subjects",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          }
        ]
      }
    },
    {
      "name": "7. Update Class",
      "type": "http-request",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/api/class/{{schoolId}}/{{sampleClassId}}",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          },
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"className\": \"Class 10-A Updated\",\n  \"maxStudents\": 45,\n  \"description\": \"Updated class description\"\n}"
        }
      }
    },
    {
      "name": "8. Delete Class",
      "type": "http-request",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/class/{{schoolId}}/{{sampleClassId}}",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    }
  ]
}