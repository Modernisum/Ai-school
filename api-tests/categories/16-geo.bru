{
  "version": "1",
  "name": "Geo & Location Management APIs",
  "type": "collection",
  "items": [
    {
      "name": "1. GET /api/geo/countries - Get All Countries",
      "type": "http-request",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/geo/countries",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    },
    {
      "name": "2. GET /api/geo/states/:countryId - Get States by Country",
      "type": "http-request",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/geo/states/101",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    },
    {
      "name": "3. GET /api/geo/districts/:stateId - Get Districts by State",
      "type": "http-request",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/geo/districts/201",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    },
    {
      "name": "4. GET /api/geo/export - Export Geo Data as JSON",
      "type": "http-request",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/geo/export",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    },
    {
      "name": "5. POST /api/geo/import - Import Geo Data from JSON",
      "type": "http-request",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/geo/import",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"countries\": [\n    {\n      \"id\": 101,\n      \"name\": \"India\",\n      \"code\": \"IN\",\n      \"phone_code\": \"+91\"\n    }\n  ],\n  \"states\": [\n    {\n      \"id\": 201,\n      \"country_id\": 101,\n      \"name\": \"Maharashtra\"\n    }\n  ],\n  \"districts\": [\n    {\n      \"id\": 301,\n      \"state_id\": 201,\n      \"name\": \"Mumbai\"\n    }\n  ]\n}"
        }
      }
    }
  ]
}