          {
            "name": "X-Admin-ID",
            "value": "admin001"
          }
        ],
        "params": [],
        "body": {
          "type": "json",
          "raw": "[\n  {\n    \"materialName\": \"Microscope\",\n    \"quantity\": 5,\n    \"condition\": \"good\"\n  },\n  {\n    \"materialName\": \"Bunsen Burner\",\n    \"quantity\": 10,\n    \"condition\": \"excellent\"\n  }\n]"
        },
        "auth": "none",
        "tests": [
          {
            "name": "Status is 200",
            "type": "javascript",
            "value": "pm.response.to.have.status(200);"
          },
          {
            "name": "Response has success true",
            "type": "javascript",
            "value": "pm.response.json().success === true;"
          },
          {
            "name": "Response has success message",
            "type": "javascript",
            "value": "pm.response.json().message === 'Materials assigned successfully';"
          }
        ]
      }
    },
    {
      "name": "8. GET /api/materials/:schoolId - List Materials",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/materials/SCH001",
        "method": "GET",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          },
          {
            "name": "X-School-ID",
            "value": "SCH001"
          },
          {
            "name": "X-Admin-ID",
            "value": "admin001"
          }
        ],
        "params": [
          {
            "name": "search",
            "value": "microscope",
            "enabled": true
          },
          {
            "name": "filter",
            "value": "available",
            "enabled": false
          },
          {
            "name": "page",
            "value": "1",
            "enabled": true
          },
          {
            "name": "limit",
            "value": "20",
            "enabled": true
          }
        ],
        "body": null,
        "auth": "none",
        "tests": [
          {
            "name": "Status is 200",
            "type": "javascript",
            "value": "pm.response.to.have.status(200);"
