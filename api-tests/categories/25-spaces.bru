{
  "version": "1",
  "name": "25. Space & Material Management APIs",
  "type": "collection",
  "items": [
    {
      "name": "1. GET /api/spaces/:schoolId/spaces - List Spaces",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/spaces/SCH001/spaces",
        "method": "GET",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          },
          {
            "name": "X-School-ID",
            "value": "SCH001"
          },
          {
            "name": "X-Admin-ID",
            "value": "admin001"
          }
        ],
        "params": [
          {
            "name": "category",
            "value": "Classroom",
            "enabled": true
          },
          {
            "name": "simple",
            "value": "true",
            "enabled": false
          }
        ],
        "body": null,
        "auth": "none",
        "tests": [
          {
            "name": "Status is 200",
            "type": "javascript",
            "value": "pm.response.to.have.status(200);"
          },
          {
            "name": "Response has success true",
            "type": "javascript",
            "value": "pm.response.json().success === true;"
          },
          {
            "name": "Response has data array",
            "type": "javascript",
            "value": "Array.isArray(pm.response.json().data);"
          }
        ]
      }
    },
    {
      "name": "2. GET /api/spaces/:schoolId/categories - List Space Categories",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/spaces/SCH001/categories",
        "method": "GET",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          },
          {
            "name": "X-School-ID",
            "value": "SCH001"
          },
          {
            "name": "X-Admin-ID",
            "value": "admin001"
          }
        ],
        "params": [],
        "body": null,
        "auth": "none",
        "tests": [
          {
            "name": "Status is 200",
            "type": "javascript",
            "value": "pm.response.to.have.status(200);"
          },
          {
            "name": "Response has success true",
            "type": "javascript",
            "value": "pm.response.json().success === true;"
          },
          {
            "name": "Response has categories array",
            "type": "javascript",
            "value": "Array.isArray(pm.response.json().categories);"
          }
        ]
      }
    },
    {
      "name": "3. POST /api/spaces/:schoolId/spaces/:category - Create Space by Category",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/spaces/SCH001/spaces/Classroom",
        "method": "POST",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          },
          {
            "name": "X-School-ID",
            "value": "SCH001"
          },
          {
            "name": "X-Admin-ID",
            "value": "admin001"
          }
        ],
        "params": [],
        "body": {
          "type": "json",
          "raw": "{\n  \"spaceName\": \"Physics Lab A\"\n}"
        },
        "auth": "none",
        "tests": [
          {
            "name": "Status is 200",
            "type": "javascript",
            "value": "pm.response.to.have.status(200);"
          },
          {
            "name": "Response has success true",
            "type": "javascript",
            "value": "pm.response.json().success === true;"
          },
          {
            "name": "Response has space object",
            "type": "javascript",
            "value": "typeof pm.response.json().space === 'object';"
          }
        ]
      }
    },
    {
      "name": "4. GET /api/spaces/:schoolId/:spaceName - Get Space Details",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/spaces/SCH001/Physics%20Lab%20A",
        "method": "GET",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          },
          {
            "name": "X-School-ID",
            "value": "SCH001"
          },
          {
            "name": "X-Admin-ID",
            "value": "admin001"
          }
        ],
        "params": [],
        "body": null,
        "auth": "none",
        "tests": [
          {
            "name": "Status is 200 or 404",
            "type": "javascript",
            "value": "pm.response.code === 200 || pm.response.code === 404;"
          },
          {
            "name": "If found, has space object",
            "type": "javascript",
            "value": "if (pm.response.code === 200) {\n  pm.expect(pm.response.json().success).to.be.true;\n  pm.expect(pm.response.json().space).to.be.an('object');\n}"
          }
        ]
      }
    },
    {
      "name": "5. PUT /api/spaces/:schoolId/:spaceName - Update Space",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/spaces/SCH001/Physics%20Lab%20A",
        "method": "PUT",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          },
          {
            "name": "X-School-ID",
            "value": "SCH001"
          },
          {
            "name": "X-Admin-ID",
            "value": "admin001"
          }
        ],
        "params": [],
        "body": {
          "type": "json",
          "raw": "{\n  \"capacity\": 30,\n  \"description\": \"Physics laboratory with updated equipment\",\n  \"status\": \"active\"\n}"
        },
        "auth": "none",
        "tests": [
          {
            "name": "Status is 200",
            "type": "javascript",
            "value": "pm.response.to.have.status(200);"
          },
          {
            "name": "Response has success true",
            "type": "javascript",
            "value": "pm.response.json().success === true;"
          },
          {
            "name": "Response has success message",
            "type": "javascript",
            "value": "pm.response.json().message === 'Space updated successfully';"
          }
        ]
      }
    },
    {
      "name": "6. DELETE /api/spaces/:schoolId/:spaceName - Delete Space",
