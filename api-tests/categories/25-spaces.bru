    {
      "name": "7. POST /api/spaces/:schoolId/:spaceName/materials - Assign Space Materials",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/spaces/SCH001/Physics%20Lab%20A/materials",
        "method": "POST",
        "headers": [
