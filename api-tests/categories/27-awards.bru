{
  "version": "1",
  "name": "Awards Management APIs",
  "type": "collection",
  "items": [
    {
      "name": "GET /api/awards/:schoolId - List Awards",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/awards/{{schoolId}}",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "GET /api/awards/:schoolId?student_id=:studentId - List Awards for Student",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/awards/{{schoolId}}?student_id={{studentId}}",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "POST /api/awards/:schoolId - Create Award",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/awards/{{schoolId}}",
        "method": "POST",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"student_id\": \"{{studentId}}\",\n  \"award_type\": \"Academic Excellence\",\n  \"title\": \"Mathematics Topper\",\n  \"description\": \"Awarded for securing first position in Mathematics in annual exams\",\n  \"award_date\": \"2024-03-15\",\n  \"presented_by\": \"Principal\",\n  \"category\": \"academic\",\n  \"level\": \"school\",\n  \"certificate_number\": \"CERT-2024-MATH-001\",\n  \"remarks\": \"Excellent performance in Mathematics\"\n}"
        }
      }
    }
  ]
}