{
  "version": "1",
  "name": "Dashboard APIs",
  "type": "collection",
  "items": [
    {
      "name": "GET /api/dashboard/:schoolId/stats - School Dashboard Stats",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/dashboard/{{schoolId}}/stats",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "GET /api/dashboard/:schoolId/leaves/proxy-suggestions - Leave Proxy Suggestions",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/dashboard/{{schoolId}}/leaves/proxy-suggestions",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    }
  ]
}