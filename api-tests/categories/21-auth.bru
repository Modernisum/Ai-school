{
  "version": "1",
  "name": "21-auth",
  "type": "collection",
  "items": [
    {
      "name": "1. Student Login",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/auth/student/login",
        "method": "POST",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"ident\": \"student123\",\n  \"password\": \"password123\"\n}"
        }
      }
    },
    {
      "name": "2. Employee Login",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/auth/employee/login",
        "method": "POST",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"ident\": \"employee456\",\n  \"password\": \"password456\"\n}"
        }
      }
    },
    {
      "name": "3. School Admin Login",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/auth/schooladmin/login",
        "method": "POST",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"school_id\": \"SCH001\",\n  \"password\": \"admin123\"\n}"
        }
      }
    },
    {
      "name": "4. School Login",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/auth/school/login",
        "method": "POST",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"school_id\": \"SCH001\",\n  \"password\": \"school123\"\n}"
        }
      }
    },
    {
      "name": "5. Verify Token",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/auth/school/verify-token",
        "method": "POST",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"token\": \"{{accessToken}}\"\n}"
        }
      }
    },
    {
      "name": "6. Logout",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/auth/school/logout",
        "method": "POST",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"token\": \"{{accessToken}}\"\n}"
        }
      }
    },
    {
      "name": "7. Set Security Question",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/auth/school/set-security",
        "method": "POST",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          },
          {
            "name": "X-School-ID",
            "value": "SCH001"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"school_id\": \"SCH001\",\n  \"question\": \"What is your mother's maiden name?\",\n  \"answer\": \"Johnson\"\n}"
        }
      }
    },
    {
      "name": "8. Verify OTP",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/auth/school/verify-otp",
        "method": "POST",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          },
          {
            "name": "X-School-ID",
            "value": "SCH001"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"school_id\": \"SCH001\",\n  \"otp\": \"123456\"\n}"
        }
      }
    },
    {
      "name": "9. Forgot Password",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/auth/school/forgot-password",
        "method": "POST",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          },
          {
            "name": "X-School-ID",
            "value": "SCH001"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"school_id\": \"SCH001\",\n  \"answer\": \"Johnson\"\n}"
        }
      }
    },
    {
      "name": "10. Change Password",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/auth/school/change-password",
        "method": "POST",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          },
          {
            "name": "X-School-ID",
            "value": "SCH001"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"school_id\": \"SCH001\",\n  \"old_password\": \"oldpassword123\",\n  \"new_password\": \"newpassword456\"\n}"
        }
      }
    },
    {
      "name": "11. Register Device",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/auth/register-device",
        "method": "POST",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"user_id\": \"user123\",\n  \"school_id\": \"SCH001\",\n  \"token\": \"device-token-abc123\",\n  \"platform\": \"android\"\n}"
        }
      }
    },
    {
      "name": "12. Create Support Request",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/auth/school/support",
        "method": "POST",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          },
          {
            "name": "X-School-ID",
            "value": "SCH001"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"school_id\": \"SCH001\",\n  \"subject\": \"Login issue\",\n  \"description\": \"Unable to login with correct credentials\",\n  \"priority\": \"high\"\n}"
        }
      }
    }
  ]
}