{
  "version": "1",
  "name": "Payment Processing APIs",
  "type": "collection",
  "items": [
    {
      "name": "Create Payment Order",
      "type": "http-request",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/payment/{{schoolId}}/create-order",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          },
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ],
        "body": {
          "mode": "json",
          "json": {
            "amount": 5000.0,
            "currency": "INR",
            "student_id": "STU001",
            "fee_type": "regular",
            "fee_id": "FEE2025Q1"
          }
        }
      }
    },
    {
      "name": "Razorpay Webhook",
      "type": "http-request",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/payment/webhook",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          },
          {
            "name": "x-razorpay-signature",
            "value": "{{razorpaySignature}}"
          }
        ],
        "body": {
          "mode": "json",
          "json": {
            "event": "payment.captured",
            "payload": {
              "payment": {
                "entity": {
                  "id": "pay_29QQoUBi66xm2f",
                  "order_id": "order_9A33XWu170gOr1",
                  "amount": 500000,
                  "currency": "INR",
                  "status": "captured"
                }
              }
            }
          }
        }
      }
    }
  ]
}