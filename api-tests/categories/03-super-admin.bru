{
  "version": "1",
  "name": "Super Admin APIs",
  "type": "collection",
  "items": [
    {
      "name": "POST /api/admin/login - Admin Login",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/admin/login",
        "method": "POST",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"username\": \"{{superAdminUsername}}\",\n  \"password\": \"{{superAdminPassword}}\"\n}"
        }
      }
    },
    {
      "name": "GET /api/admin/profile - Get Admin Profile",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/admin/profile",
        "method": "GET",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {{superAdminToken}}"
          }
        ]
      }
    },
    {
      "name": "POST /api/admin/update-credentials - Update Admin Credentials",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/admin/update-credentials",
        "method": "POST",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {{superAdminToken}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"currentPassword\": \"{{superAdminPassword}}\",\n  \"newPassword\": \"NewPassword123!\",\n  \"confirmPassword\": \"NewPassword123!\"\n}"
        }
      }
    },
    {
      "name": "GET /api/admin/stats - Admin Dashboard Stats",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/admin/stats",
        "method": "GET",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {{superAdminToken}}"
          }
        ]
      }
    },
    {
      "name": "GET /api/admin/stats/advanced - Advanced Admin Stats",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/admin/stats/advanced",
        "method": "GET",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {{superAdminToken}}"
          }
        ]
      }
    },
    {
      "name": "GET /api/admin/churn-radar - Churn Radar",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/admin/churn-radar",
        "method": "GET",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {{superAdminToken}}"
          }
        ]
      }
    },
    {
      "name": "GET /api/admin/schools - List All Schools",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/admin/schools",
        "method": "GET",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {{superAdminToken}}"
          }
        ]
      }
    },
    {
      "name": "GET /api/admin/schools/:schoolId - Get School Details",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/admin/schools/{{schoolId}}",
        "method": "GET",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {{superAdminToken}}"
          }
        ]
      }
    },
    {
      "name": "PUT /api/admin/schools/:schoolId - Update School",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/admin/schools/{{schoolId}}",
        "method": "PUT",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {{superAdminToken}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"name\": \"Updated School Name\",\n  \"address\": \"Updated Address\",\n  \"contact\": \"updated@email.com\",\n  \"status\": \"active\"\n}"
        }
      }
    },
    {
      "name": "DELETE /api/admin/schools/:schoolId - Delete School",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/admin/schools/{{schoolId}}",
        "method": "DELETE",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {{superAdminToken}}"
          }
        ]
      }
    },
    {
      "name": "PATCH /api/admin/schools/:schoolId/status - Set School Status",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/admin/schools/{{schoolId}}/status",
        "method": "PATCH",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {{superAdminToken}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"status\": \"suspended\"\n}"
        }
      }
    },
    {
      "name": "GET /api/admin/schools/export/all - Export All Schools",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/admin/schools/export/all",
        "method": "GET",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {{superAdminToken}}"
          }
        ]
      }
    },
    {
      "name": "GET /api/admin/schools/:schoolId/export - Export Single School",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/admin/schools/{{schoolId}}/export",
        "method": "GET",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {{superAdminToken}}"
          }
        ]
      }
    },
    {
      "name": "POST /api/admin/schools/:schoolId/import - Import School Data",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/admin/schools/{{schoolId}}/import",
        "method": "POST",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {{superAdminToken}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"data\": \"base64_encoded_export_data_here\"\n}"
        }
      }
    },
    {
      "name": "GET /api/admin/support - List Support Requests",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/admin/support",
        "method": "GET",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {{superAdminToken}}"
          }
        ]
      }
    },
    {
      "name": "POST /api/admin/backup - Manual Backup",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/admin/backup",
        "method": "POST",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {{superAdminToken}}"
          }
        ]
      }
    }
  ]
}