{
  "version": "1",
  "name": "Recovery & Audit",
  "type": "collection",
  "items": [
    {
      "name": "List Student History",
      "type": "http",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/recovery/:schoolId/student-history",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "success": true,
          "data": [
            {
              "id": 1,
              "studentId": "STU001",
              "action": "update",
              "tableName": "students",
              "oldData": {
                "name": "John Doe",
                "grade": "10"
              },
              "newData": {
                "name": "John Smith",
                "grade": "10"
              },
              "changedBy": "admin123",
              "changedAt": "2024-03-15T10:30:00Z"
            },
            {
              "id": 2,
              "studentId": "STU002",
              "action": "delete",
              "tableName": "students",
              "oldData": {
                "name": "Jane Doe",
                "grade": "11"
              },
              "newData": null,
              "changedBy": "admin456",
              "changedAt": "2024-03-14T14:20:00Z"
            }
          ]
        }
      }
    },
    {
      "name": "Undo Student Change",
      "type": "http",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/recovery/:schoolId/student-history/:id/undo",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "success": true,
          "message": "Change reverted successfully"
        }
      }
    },
    {
      "name": "List Audit Logs",
      "type": "http",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/recovery/:schoolId/audit-logs",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          },
          {
            "name": "module",
            "value": "students"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "success": true,
          "data": [
            {
              "logId": 101,
              "userId": "admin123",
              "action": "CREATE",
              "module": "students",
              "entityId": "STU001",
              "oldValue": null,
              "newValue": "{\"name\":\"John Doe\",\"grade\":\"10\"}",
              "ipAddress": "192.168.1.100",
              "userAgent": "Mozilla/5.0",
              "timestamp": "2024-03-15T10:30:00Z"
            },
            {
              "logId": 102,
              "userId": "admin456",
              "action": "UPDATE",
              "module": "employees",
              "entityId": "EMP001",
              "oldValue": "{\"salary\":50000}",
              "newValue": "{\"salary\":55000}",
              "ipAddress": "192.168.1.101",
              "userAgent": "PostmanRuntime/7.36.0",
              "timestamp": "2024-03-14T14:20:00Z"
            }
          ]
        }
      }
    },
    {
      "name": "Undo Audit Log",
      "type": "http",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/recovery/:schoolId/audit-logs/:logId/undo",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "success": true,
          "message": "Audit log reversion submitted."
        }
      }
    }
  ]
}