{
  "version": "1",
  "name": "Events Management APIs",
  "type": "collection",
  "items": [
    {
      "name": "Create Event",
      "type": "http-request",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/events/{{schoolId}}",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          },
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ],
        "body": {
          "mode": "json",
          "json": {
            "title": "Annual Sports Day",
            "description": "School annual sports competition",
            "event_date": "2025-03-15",
            "event_time": "09:00:00",
            "venue": "School Ground",
            "organizer": "Sports Department",
            "participants": ["STU001", "STU002", "EMP001"],
            "category": "sports"
          }
        }
      }
    }
  ]
}