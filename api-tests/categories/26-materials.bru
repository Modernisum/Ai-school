{
  "version": "1",
  "name": "Academic Materials APIs",
  "type": "collection",
  "items": [
    {
      "name": "GET /api/materials/:schoolId - List All Materials",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/materials/{{schoolId}}",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "GET /api/materials/:schoolId/:materialName - Get Material Details",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/materials/{{schoolId}}/{{materialName}}",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "POST /api/materials/:schoolId - Create New Material",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/materials/{{schoolId}}",
        "method": "POST",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"materialName\": \"Mathematics Textbook\",\n  \"category\": \"Books\",\n  \"quantity\": 50,\n  \"unitPrice\": 250.00,\n  \"description\": \"Class 10 Mathematics textbook for CBSE curriculum\",\n  \"supplier\": \"NCERT Publications\",\n  \"minimumStockLevel\": 10,\n  \"reorderPoint\": 15,\n  \"storageLocation\": \"Library Shelf A3\",\n  \"isConsumable\": false\n}"
        }
      }
    },
    {
      "name": "PUT /api/materials/:schoolId/:materialName - Update Material",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/materials/{{schoolId}}/{{materialName}}",
        "method": "PUT",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"quantity\": 45,\n  \"unitPrice\": 260.00,\n  \"description\": \"Updated Class 10 Mathematics textbook with latest syllabus\",\n  \"minimumStockLevel\": 12\n}"
        }
      }
    },
    {
      "name": "DELETE /api/materials/:schoolId/:materialName - Delete Material",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/materials/{{schoolId}}/{{materialName}}",
        "method": "DELETE",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "POST /api/materials/:schoolId/bulk - Bulk Import Materials",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/materials/{{schoolId}}/bulk",
        "method": "POST",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"materials\": [\n    {\n      \"materialName\": \"Science Lab Kit\",\n      \"category\": \"Lab Equipment\",\n      \"quantity\": 20,\n      \"unitPrice\": 1200.00\n    },\n    {\n      \"materialName\": \"Art Supplies Pack\",\n      \"category\": \"Stationery\",\n      \"quantity\": 100,\n      \"unitPrice\": 150.00\n    },\n    {\n      \"materialName\": \"Sports Equipment\",\n      \"category\": \"Sports\",\n      \"quantity\": 30,\n      \"unitPrice\": 800.00\n    }\n  ]\n}"
        }
      }
    }
  ]
}