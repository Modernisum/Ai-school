{
  "version": "1",
  "name": "Attendance Management APIs - Supplemental",
  "type": "collection",
  "items": [
    {
      "name": "PUT /api/operations/attendance/:schoolId/:role/:userId/:date - Update Attendance",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/operations/attendance/{{schoolId}}/student/{{studentId}}/{{currentDate}}",
        "method": "PUT",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"status\": \"present\",\n  \"remarks\": \"Updated attendance\",\n  \"in_time\": \"08:30:00\",\n  \"out_time\": \"15:30:00\"\n}"
        }
      }
    },
    {
      "name": "DELETE /api/operations/attendance/:schoolId/:role/:userId/:date - Delete Attendance",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/operations/attendance/{{schoolId}}/student/{{studentId}}/{{currentDate}}",
        "method": "DELETE",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "GET /api/operations/attendance/:schoolId/holidays - List School Holidays",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/operations/attendance/{{schoolId}}/holidays",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "POST /api/operations/attendance/:schoolId/holidays - Create School Holiday",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/operations/attendance/{{schoolId}}/holidays",
        "method": "POST",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"date\": \"{{currentDate}}\",\n  \"name\": \"Test Holiday\",\n  \"description\": \"Test holiday for API testing\",\n  \"type\": \"public\"\n}"
        }
      }
    },
    {
      "name": "GET /api/operations/attendance/:schoolId/holidays/check - Check School Holiday",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/operations/attendance/{{schoolId}}/holidays/check?date={{currentDate}}",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "GET /api/operations/attendance/:schoolId/holidays/:holidayId - Get Holiday Detail",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/operations/attendance/{{schoolId}}/holidays/{{holidayId}}",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "DELETE /api/operations/attendance/:schoolId/holidays/:holidayId - Delete School Holiday",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/operations/attendance/{{schoolId}}/holidays/{{holidayId}}",
        "method": "DELETE",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "GET /api/operations/attendance/:schoolId/class-attendance - Get Class Attendance",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/operations/attendance/{{schoolId}}/class-attendance?class_name=10th&date={{currentDate}}",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "POST /api/operations/attendance/:schoolId/qr-attendance - Generate QR Attendance",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/operations/attendance/{{schoolId}}/qr-attendance",
        "method": "POST",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"class_name\": \"10th\",\n  \"valid_for_minutes\": 30,\n  \"location\": {\n    \"latitude\": 28.6139,\n    \"longitude\": 77.2090\n  }\n}"
        }
      }
    },
    {
      "name": "POST /api/operations/attendance/:schoolId/mobile-attendance - Mobile Mark Attendance",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/operations/attendance/{{schoolId}}/mobile-attendance",
        "method": "POST",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"user_id\": \"{{studentId}}\",\n  \"role\": \"student\",\n  \"date\": \"{{currentDate}}\",\n  \"status\": \"present\",\n  \"location\": {\n    \"latitude\": 28.6139,\n    \"longitude\": 77.2090\n  },\n  \"device_id\": \"test-device-123\"\n}"
        }
      }
    },
    {
      "name": "POST /api/operations/attendance/:schoolId/offline-sync - Offline Sync Attendance",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/operations/attendance/{{schoolId}}/offline-sync",
        "method": "POST",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"records\": [\n    {\n      \"user_id\": \"{{studentId}}\",\n      \"role\": \"student\",\n      \"date\": \"{{currentDate}}\",\n      \"status\": \"present\",\n      \"timestamp\": \"{{currentDateTime}}\",\n      \"device_id\": \"offline-device-001\"\n    }\n  ]\n}"
        }
      }
    },
    {
      "name": "GET /api/operations/attendance/:schoolId/reports/student - Student Report",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/operations/attendance/{{schoolId}}/reports/student?student_id={{studentId}}&start_date=2024-01-01&end_date=2024-12-31",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "GET /api/operations/attendance/:schoolId/reports/class - Class Report",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/operations/attendance/{{schoolId}}/reports/class?class_name=10th&start_date=2024-01-01&end_date=2024-12-31",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "GET /api/operations/attendance/:schoolId/reports/employee - Employee Report",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/operations/attendance/{{schoolId}}/reports/employee?employee_id={{employeeId}}&start_date=2024-01-01&end_date=2024-12-31",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "POST /api/operations/attendance/:schoolId/reports/custom - Generate Custom Report",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/operations/attendance/{{schoolId}}/reports/custom",
        "method": "POST",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"report_type\": \"attendance_summary\",\n  \"filters\": {\n    \"start_date\": \"2024-01-01\",\n    \"end_date\": \"2024-12-31\",\n    \"class_name\": \"10th\",\n    \"status\": \"present\"\n  },\n  \"format\": \"json\"\n}"
        }
      }
    }
  ]
}