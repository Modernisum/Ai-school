{
  "version": "1",
  "name": "Supplemental Missing Endpoints",
  "type": "collection",
  "items": [
    {
      "name": "Super Admin - Get Admin Profile",
      "type": "http-request",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/admin/profile",
        "headers": [
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "Super Admin - Update Admin Credentials",
      "type": "http-request",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/admin/update-credentials",
        "headers": [
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\"currentPassword\":\"current123\",\"newPassword\":\"newpassword123\",\"confirmPassword\":\"newpassword123\"}"
        }
      }
    },
    {
      "name": "Super Admin - Get Admin Dashboard Stats",
      "type": "http-request",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/admin/stats",
        "headers": [
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "Super Admin - Get Admin Stats Advanced",
      "type": "http-request",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/admin/stats/advanced",
        "headers": [
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "Super Admin - Get Churn Radar",
