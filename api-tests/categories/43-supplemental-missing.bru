        "url": "{{baseUrl}}/api/admin/churn-radar",
        "headers": [
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "Super Admin - Create Promo Code",
      "type": "http-request",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/admin/promos",
        "headers": [
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\"code\":\"TESTPROMO25\",\"discountPercentage\":25,\"maxUses\":100,\"expiresAt\":\"2024-12-31T23:59:59Z\"}"
        }
      }
    },
    {
      "name": "Super Admin - Get Promo Usage",
      "type": "http-request",
