{
  "version": "1",
  "name": "Announcements Management",
  "type": "collection",
  "items": [
    {
      "name": "Create Announcement",
      "type": "http",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/announcements/:schoolId/:typeStr/:userId",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          },
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ],
        "body": {
          "mode": "json",
          "json": {
            "title": "Important School Announcement",
            "content": "This is an important announcement for all students and staff regarding upcoming events.",
            "priority": "high",
            "targetAudience": ["students", "teachers"],
            "expiresAt": "2025-12-31T23:59:59Z",
            "attachments": []
          }
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "success": true,
          "data": {
            "announcementId": "{{$random.uuid}}",
            "title": "Important School Announcement",
            "content": "This is an important announcement for all students and staff regarding upcoming events.",
            "priority": "high",
            "createdBy": "{{adminId}}",
            "createdAt": "{{$timestamp.iso}}",
            "expiresAt": "2025-12-31T23:59:59Z"
          }
        }
      }
    }
  ]
}