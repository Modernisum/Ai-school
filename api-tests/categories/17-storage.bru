{
  "version": "1",
  "name": "Storage & Upload Management APIs",
  "type": "collection",
  "items": [
    {
      "name": "1. POST /api/storage/upload - Upload File (Multipart)",
      "type": "http-request",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/storage/upload",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "test-file.txt"
            },
            {
              "key": "folder",
              "value": "documents",
              "type": "text"
            }
          ]
        }
      }
    },
    {
      "name": "2. GET /api/storage/files - List Files",
      "type": "http-request",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/storage/files",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "3. DELETE /api/storage/files/:id - Delete File by ID",
      "type": "http-request",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/storage/files/123",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "4. DELETE /api/storage/file-by-url - Delete File by URL",
      "type": "http-request",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/storage/file-by-url?url=https://storage.example.com/files/test.jpg",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    }
  ]
}