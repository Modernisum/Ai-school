    {
      "name": "POST /api/leave/:schoolId/:leaveId/conditional/approve - Apply Conditional Approval",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/leave/{{schoolId}}/{{leaveId}}/conditional/approve",
        "method": "POST",
        "headers": [
