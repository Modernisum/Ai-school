            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"responses\": [\n    {\n      \"conditionId\": \"cond-123\",\n      \"status\": \"completed\",\n      \"evidence\": \"https://example.com/medical_certificate_uploaded.pdf\",\n      \"notes\": \"Medical certificate uploaded\"\n    }\n  ]\n}"
        }
      }
    },
    {
      "name": "GET /api/leave/:schoolId/conditional/templates - Get Conditional Templates",
      "type": "http-request",
