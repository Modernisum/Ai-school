          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"days\": 2,\n  \"reason\": \"Medical extension required\"\n}"
        }
      }
    },
    {
      "name": "POST /api/leave/:schoolId/:leaveId/reduce - Reduce Leave",
      "type": "http-request",
