    {
      "name": "POST /api/leave/:schoolId/conditional/templates - Create Conditional Template",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/leave/{{schoolId}}/conditional/templates",
        "method": "POST",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"name\": \"Medical Leave Template\",\n  \"description\": \"Standard conditions for medical leaves\",\n  \"conditions\": [\n    {\n      \"type\": \"document_upload\",\n      \"description\": \"Medical certificate from registered doctor\",\n      \"required\": true\n    },\n    {\n      \"type\": \"coverage_arranged\",\n      \"description\": \"Class coverage arranged for duration\",\n      \"required\": true\n    }\n  ],\n  \"applicableTo\": [\"medical\", \"sick\"]\n}"
        }
      }
    },
