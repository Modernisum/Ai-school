          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"conditions\": [\n    {\n      \"type\": \"document_upload\",\n      \"description\": \"Upload medical certificate\",\n      \"deadline\": \"2025-04-20\"\n    },\n    {\n      \"type\": \"coverage_arranged\",\n      \"description\": \"Arrange coverage for classes\",\n      \"deadline\": \"2025-04-14\"\n    }\n  ],\n  \"approvalDeadline\": \"2025-04-14\"\n}"
        }
      }
    },
    {
      "name": "POST /api/leave/:schoolId/:leaveId/conditional/respond - Respond to Conditions",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/leave/{{schoolId}}/{{leaveId}}/conditional/respond",
        "method": "POST",
        "headers": [
