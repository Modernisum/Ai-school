{
  "version": "1",
  "name": "Leave Management APIs",
  "type": "collection",
  "items": [
    {
      "name": "POST /api/leave/:schoolId - Create Leave",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/leave/{{schoolId}}",
        "method": "POST",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"employeeId\": \"{{employeeId}}\",\n  \"employeeName\": \"Rajesh Kumar\",\n  \"leaveType\": \"casual\",\n  \"startDate\": \"2025-04-15\",\n  \"endDate\": \"2025-04-17\",\n  \"duration\": 3,\n  \"reason\": \"Family function\",\n  \"contactDuringLeave\": \"+919876543210\",\n  \"emergencyContact\": \"+919876543211\",\n  \"responsibilities\": [\"Class 10A Mathematics\", \"Exam Coordinator\"],\n  \"documents\": [\n    {\n      \"type\": \"medical\",\n      \"url\": \"https://example.com/medical_certificate.pdf\"\n    }\n  ]\n}"
        }
      }
    },
    {
      "name": "GET /api/leave/:schoolId - List Leaves",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/leave/{{schoolId}}",
