{
  "version": "1",
  "name": "Student Management APIs",
  "type": "collection",
  "items": [
    {
      "name": "POST /api/students/:schoolId - Create Student",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/students/{{schoolId}}",
        "method": "POST",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"student_id\": \"STU001\",\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\",\n  \"date_of_birth\": \"2010-05-15\",\n  \"gender\": \"male\",\n  \"class_name\": \"10th\",\n  \"section\": \"A\",\n  \"father_name\": \"Robert Doe\",\n  \"mother_name\": \"Jane Doe\",\n  \"contact_number\": \"+919876543210\",\n  \"address\": \"123 Main Street, Delhi\",\n  \"aadhaar_number\": \"123456789012\",\n  \"enrollment_date\": \"2024-01-15\"\n}"
        }
      }
    },
    {
      "name": "POST /api/students/:schoolId/validate - Validate Student Data",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/students/{{schoolId}}/validate",
        "method": "POST",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"student_id\": \"STU001\",\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\",\n  \"date_of_birth\": \"2010-05-15\",\n  \"gender\": \"male\",\n  \"class_name\": \"10th\",\n  \"section\": \"A\"\n}"
        }
      }
    },
    {
      "name": "POST /api/students/:schoolId/bulk - Bulk Import Students",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/students/{{schoolId}}/bulk",
        "method": "POST",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"students\": [\n    {\n      \"student_id\": \"STU001\",\n      \"first_name\": \"John\",\n      \"last_name\": \"Doe\",\n      \"date_of_birth\": \"2010-05-15\",\n      \"gender\": \"male\",\n      \"class_name\": \"10th\",\n      \"section\": \"A\"\n    },\n    {\n      \"student_id\": \"STU002\",\n      \"first_name\": \"Jane\",\n      \"last_name\": \"Smith\",\n      \"date_of_birth\": \"2010-08-20\",\n      \"gender\": \"female\",\n      \"class_name\": \"10th\",\n      \"section\": \"B\"\n    }\n  ]\n}"
        }
      }
    },
    {
      "name": "GET /api/students/:schoolId - List All Students",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/students/{{schoolId}}",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "GET /api/students/:schoolId/paginated - List Students Paginated",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/students/{{schoolId}}/paginated?page=1&limit=20",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "GET /api/students/:schoolId/class/:className - List Students by Class",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/students/{{schoolId}}/class/10th",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "GET /api/students/:schoolId/studentIds - List Student IDs",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/students/{{schoolId}}/studentIds",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "GET /api/students/:schoolId/:studentId - Get Student Details",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/students/{{schoolId}}/{{studentId}}",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "PUT /api/students/:schoolId/:studentId - Update Student",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/students/{{schoolId}}/{{studentId}}",
        "method": "PUT",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"first_name\": \"John Updated\",\n  \"last_name\": \"Doe Updated\",\n  \"class_name\": \"11th\",\n  \"section\": \"B\",\n  \"contact_number\": \"+919876543211\"\n}"
        }
      }
    },
    {
      "name": "DELETE /api/students/:schoolId/:studentId - Delete Student",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/students/{{schoolId}}/{{studentId}}",
        "method": "DELETE",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    }
  ]
}