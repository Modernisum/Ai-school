{
  "version": "1",
  "name": "WebSocket APIs",
  "type": "collection",
  "items": [
    {
      "name": "General WebSocket Connection",
      "type": "http-request",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/ws",
        "headers": [
          {
            "name": "Upgrade",
            "value": "websocket"
          },
          {
            "name": "Connection",
            "value": "Upgrade"
          },
          {
            "name": "Sec-WebSocket-Key",
            "value": "dGhlIHNhbXBsZSBub25jZQ=="
          },
          {
            "name": "Sec-WebSocket-Version",
            "value": "13"
          },
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          }
        ]
      }
    },
    {
      "name": "Responsibility WebSocket Connection",
      "type": "http-request",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/responsibility-ws",
        "headers": [
          {
            "name": "Upgrade",
            "value": "websocket"
          },
          {
            "name": "Connection",
            "value": "Upgrade"
          },
          {
            "name": "Sec-WebSocket-Key",
            "value": "dGhlIHNhbXBsZSBub25jZQ=="
          },
          {
            "name": "Sec-WebSocket-Version",
            "value": "13"
          },
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    }
  ]
}