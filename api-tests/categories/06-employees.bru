{
  "version": "1",
  "name": "Employee Management APIs",
  "type": "collection",
  "items": [
    {
      "name": "POST /api/employees/:schoolId - Create Employee",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/employees/{{schoolId}}",
        "method": "POST",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"name\": \"Rajesh Kumar\",\n  \"father_name\": \"Suresh Kumar\",\n  \"mother_name\": \"Meena Devi\",\n  \"dob\": \"1985-08-15\",\n  \"age\": null,\n  \"gender\": \"male\",\n  \"category\": \"general\",\n  \"employee_type\": \"teacher\",\n  \"base_salary\": 45000.00,\n  \"email\": \"rajesh.kumar@testschool.com\",\n  \"phone\": \"+919876543210\",\n  \"alternative_contact\": \"+919876543211\",\n  \"permanent_address\": \"123 Main Street, Delhi\",\n  \"temporary_address\": \"456 Park Avenue, Delhi\",\n  \"experience\": 10,\n  \"education\": \"M.Sc. Mathematics\",\n  \"aadhaar_number\": \"123456789012\",\n  \"responsibilities\": [\"Class 10A Mathematics\", \"Exam Coordinator\"],\n  \"bank_details\": {\n    \"account_number\": \"1234567890\",\n    \"bank_name\": \"State Bank of India\",\n    \"ifsc_code\": \"SBIN0001234\"\n  },\n  \"profile_image_url\": \"https://example.com/profile.jpg\",\n  \"roles\": [\"teacher\", \"exam_coordinator\"]\n}"
        }
      }
    },
    {
      "name": "POST /api/employees/:schoolId/validate - Validate Employee Data",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/employees/{{schoolId}}/validate",
        "method": "POST",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"name\": \"Priya Sharma\",\n  \"email\": \"priya.sharma@testschool.com\",\n  \"phone\": \"+919876543212\",\n  \"employee_type\": \"teacher\",\n  \"base_salary\": 40000.00\n}"
        }
      }
    },
    {
      "name": "POST /api/employees/:schoolId/bulk - Bulk Import Employees",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/employees/{{schoolId}}/bulk",
        "method": "POST",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"employees\": [\n    {\n      \"Name\": \"Amit Patel\",\n      \"Type\": \"teacher\",\n      \"Email\": \"amit.patel@testschool.com\",\n      \"Phone Number\": \"+919876543213\",\n      \"Subject\": \"Physics\",\n      \"Department\": \"Science\",\n      \"Base Salary\": 42000.00\n    },\n    {\n      \"Name\": \"Sunita Reddy\",\n      \"Type\": \"principal\",\n      \"Email\": \"sunita.reddy@testschool.com\",\n      \"Phone Number\": \"+919876543214\",\n      \"Subject\": \"Administration\",\n      \"Department\": \"Administration\",\n      \"Base Salary\": 75000.00\n    },\n    {\n      \"Name\": \"Rahul Verma\",\n      \"Type\": \"staff\",\n      \"Email\": \"rahul.verma@testschool.com\",\n      \"Phone Number\": \"+919876543215\",\n      \"Subject\": \"Office\",\n      \"Department\": \"Administration\",\n      \"Base Salary\": 25000.00\n    }\n  ]\n}"
        }
      }
    },
    {
      "name": "GET /api/employees/:schoolId - List Employees",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/employees/{{schoolId}}",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "GET /api/employees/:schoolId/:employeeId - Get Employee",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/employees/{{schoolId}}/{{employeeId}}",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "PUT /api/employees/:schoolId/:employeeId - Update Employee",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/employees/{{schoolId}}/{{employeeId}}",
        "method": "PUT",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"name\": \"Rajesh Kumar Updated\",\n  \"father_name\": \"Suresh Kumar\",\n  \"mother_name\": \"Meena Devi\",\n  \"dob\": \"1985-08-15\",\n  \"age\": null,\n  \"gender\": \"male\",\n  \"category\": \"general\",\n  \"employee_type\": \"senior_teacher\",\n  \"base_salary\": 50000.00,\n  \"email\": \"rajesh.kumar@testschool.com\",\n  \"phone\": \"+919876543210\",\n  \"alternative_contact\": \"+919876543211\",\n  \"permanent_address\": \"123 Main Street, Delhi\",\n  \"temporary_address\": \"456 Park Avenue, Delhi\",\n  \"experience\": 12,\n  \"education\": \"M.Sc. Mathematics, B.Ed.\",\n  \"aadhaar_number\": \"123456789012\",\n  \"responsibilities\": [\"Class 10A Mathematics\", \"Exam Coordinator\", \"Department Head\"],\n  \"bank_details\": {\n    \"account_number\": \"1234567890\",\n    \"bank_name\": \"State Bank of India\",\n    \"ifsc_code\": \"SBIN0001234\"\n  },\n  \"profile_image_url\": \"https://example.com/profile_updated.jpg\",\n  \"roles\": [\"senior_teacher\", \"exam_coordinator\", \"department_head\"]\n}"
        }
      }
    },
    {
      "name": "DELETE /api/employees/:schoolId/:employeeId - Delete Employee",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/employees/{{schoolId}}/{{employeeId}}",
        "method": "DELETE",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "GET /api/employees/:schoolId/:employeeId/salary-breakdown - Get Salary Breakdown",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/employees/{{schoolId}}/{{employeeId}}/salary-breakdown",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "POST /api/employees/:schoolId/:employeeId/bonus - Add Bonus",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/employees/{{schoolId}}/{{employeeId}}/bonus",
        "method": "POST",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"amount\": 5000.00,\n  \"reason\": \"Performance bonus for excellent teaching\",\n  \"month\": \"2025-03\",\n  \"description\": \"Awarded for outstanding student performance in board exams\"\n}"
        }
      }
    },
    {
      "name": "POST /api/employees/:schoolId/:employeeId/aid - Add Financial Aid",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/employees/{{schoolId}}/{{employeeId}}/aid",
        "method": "POST",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"amount\": 10000.00,\n  \"reason\": \"Medical emergency assistance\",\n  \"description\": \"Financial aid for employee's medical treatment\"\n}"
        }
      }
    },
    {
      "name": "POST /api/employees/:schoolId/:employeeId/close-month - Auto Close Month",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/employees/{{schoolId}}/{{employeeId}}/close-month",
        "method": "POST",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"month\": \"2025-03\",\n  \"generate_payslip\": true\n}"
        }
      }
    },
    {
      "name": "POST /api/employees/:schoolId/employees/:employeeId/salary - Set Base Salary",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/employees/{{schoolId}}/employees/{{employeeId}}/salary",
        "method": "POST",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"base_salary\": 55000.00,\n  \"effective_from\": \"2025-04-01\",\n  \"reason\": \"Promotion to senior teacher\"\n}"
        }
      }
    }
  ]
}