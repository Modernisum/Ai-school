{
  "version": "1",
  "name": "23-setup",
  "type": "collection",
  "items": [
    {
      "name": "1. Get Setup Details",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/setup/SCH001",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "SCH001"
          },
          {
            "name": "X-Admin-ID",
            "value": "admin001"
          }
        ]
      }
    },
    {
      "name": "2. Setup New School",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/setup/school",
        "method": "POST",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"name\": \"New Test School\",\n  \"address\": \"123 Test Street\",\n  \"phone\": \"9876543210\",\n  \"email\": \"test@school.com\",\n  \"principal_name\": \"Test Principal\",\n  \"established_year\": 2024,\n  \"password\": \"school123\",\n  \"school_type\": \"private\",\n  \"board\": \"CBSE\",\n  \"medium\": \"english\",\n  \"classes\": [\"1\", \"2\", \"3\", \"4\", \"5\"],\n  \"subjects\": [\"Math\", \"Science\", \"English\"],\n  \"admin_name\": \"Admin User\",\n  \"admin_email\": \"admin@school.com\",\n  \"admin_phone\": \"9876543211\"\n}"
        }
      }
    }
  ]
}