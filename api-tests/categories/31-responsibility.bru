        "body": {
          "mode": "raw",
          "raw": "{\n  \"employeeIds\": [\"employee-001\", \"employee-002\", \"employee-003\"],\n  \"assignmentDate\": \"2026-01-15\",\n  \"notes\": \"Bulk assignment for new semester\"\n}"
        }
      }
    },
