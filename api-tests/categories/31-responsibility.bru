{
  "version": "1",
  "name": "Responsibility Management APIs",
  "type": "collection",
  "items": [
    {
      "name": "1. List Responsibilities (GET /api/responsibility/:schoolId)",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/responsibility/{{schoolId}}",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "2. List Responsibilities Paginated (GET /api/responsibility/:schoolId?paginated=true)",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/responsibility/{{schoolId}}?paginated=true&page=1&limit=10",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "3. Create Responsibility (POST /api/responsibility/:schoolId)",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/responsibility/{{schoolId}}",
        "method": "POST",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Class Monitor\",\n  \"description\": \"Responsible for maintaining classroom discipline\",\n  \"employeeType\": \"teacher\",\n  \"priority\": \"medium\",\n  \"estimatedHoursPerWeek\": 5,\n  \"compensation\": 0,\n  \"startDate\": \"2026-01-01\",\n  \"endDate\": \"2026-12-31\",\n  \"isActive\": true\n}"
        }
      }
    },
    {
      "name": "4. Get Responsibility Definition (GET /api/responsibility/:schoolId/:responsibilityId)",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/responsibility/{{schoolId}}/responsibility-001",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "5. Update Responsibility (PATCH /api/responsibility/:schoolId/:responsibilityId)",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/responsibility/{{schoolId}}/responsibility-001",
        "method": "PATCH",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Class Monitor - Updated\",\n  \"description\": \"Updated responsibility description\",\n  \"priority\": \"high\",\n  \"estimatedHoursPerWeek\": 8\n}"
        }
      }
    },
    {
      "name": "6. Delete Responsibility (DELETE /api/responsibility/:schoolId/:responsibilityId)",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/responsibility/{{schoolId}}/responsibility-001",
        "method": "DELETE",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "7. Get Responsibility Analytics (GET /api/responsibility/:schoolId/:responsibilityId/analytics)",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/responsibility/{{schoolId}}/responsibility-001/analytics",
