{
  "version": "1",
  "name": "Responsibility Management APIs - Supplemental",
  "type": "collection",
  "items": [
    {
      "name": "GET /api/responsibility/:schoolId/spaces/:spaceId/responsibilities - List Space Responsibilities",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/responsibility/{{schoolId}}/spaces/{{spaceId}}/responsibilities",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "GET /api/responsibility/:schoolId/responsibilities/search - Search Responsibilities",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/responsibility/{{schoolId}}/responsibilities/search?query=math&employee_type=teacher",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "DELETE /api/responsibility/:schoolId/responsibilities/:responsibilityId/bulk-remove - Bulk Remove Responsibility",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/responsibility/{{schoolId}}/responsibilities/{{responsibilityId}}/bulk-remove",
        "method": "DELETE",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"employee_ids\": [\"{{employeeId}}\", \"{{employeeId2}}\"],\n  \"reason\": \"Reassignment\"\n}"
        }
      }
    },
    {
      "name": "PUT /api/responsibility/:schoolId/responsibilities/:responsibilityId/bulk-update - Bulk Update Responsibility",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/responsibility/{{schoolId}}/responsibilities/{{responsibilityId}}/bulk-update",
        "method": "PUT",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"updates\": [\n    {\n      \"employee_id\": \"{{employeeId}}\",\n      \"priority\": \"high\",\n      \"status\": \"active\"\n    }\n  ]\n}"
        }
      }
    },
    {
      "name": "GET /api/responsibility/:schoolId/responsibilities/:responsibilityId/versions - Get Responsibility Versions",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/responsibility/{{schoolId}}/responsibilities/{{responsibilityId}}/versions",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "POST /api/responsibility/:schoolId/responsibilities/:responsibilityId/rollback/:version - Rollback Responsibility",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/responsibility/{{schoolId}}/responsibilities/{{responsibilityId}}/rollback/1",
        "method": "POST",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"reason\": \"Revert to previous version\"\n}"
        }
      }
    },
    {
      "name": "GET /api/responsibility/:schoolId/metrics/space-distribution - Space Distribution Metrics",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/responsibility/{{schoolId}}/metrics/space-distribution",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "GET /api/responsibility/:schoolId/metrics/revenue - Revenue Metrics",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/responsibility/{{schoolId}}/metrics/revenue",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "GET /api/responsibility/:schoolId/reports/space-distribution/:startDate/:endDate - Space Distribution Report",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/responsibility/{{schoolId}}/reports/space-distribution/2024-01-01/2024-12-31",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "GET /api/responsibility/:schoolId/reports/revenue/:startDate/:endDate - Revenue Report",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/responsibility/{{schoolId}}/reports/revenue/2024-01-01/2024-12-31",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "GET /api/responsibility/:schoolId/reports/utilization/:startDate/:endDate/pdf - Utilization Report PDF",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/responsibility/{{schoolId}}/reports/utilization/2024-01-01/2024-12-31/pdf",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "GET /api/responsibility/:schoolId/reports/workload/:startDate/:endDate/pdf - Workload Report PDF",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/responsibility/{{schoolId}}/reports/workload/2024-01-01/2024-12-31/pdf",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    }
  ]
}