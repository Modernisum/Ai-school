{
  "version": "1",
  "name": "22-school-self",
  "type": "collection",
  "items": [
    {
      "name": "1. Get School Details",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/school/SCH001/details",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "SCH001"
          },
          {
            "name": "X-Admin-ID",
            "value": "admin001"
          }
        ],
        "query": {
          "filter": "basic"
        }
      }
    },
    {
      "name": "2. Update School Self",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/school/SCH001",
        "method": "PUT",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          },
          {
            "name": "X-School-ID",
            "value": "SCH001"
          },
          {
            "name": "X-Admin-ID",
            "value": "admin001"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"name\": \"Updated School Name\",\n  \"address\": \"123 Updated Street\",\n  \"phone\": \"9876543210\",\n  \"email\": \"updated@school.com\",\n  \"principal_name\": \"Updated Principal\",\n  \"established_year\": 2005\n}"
        }
      }
    },
    {
      "name": "3. Change Password Self",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/school/SCH001/password",
        "method": "PATCH",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          },
          {
            "name": "X-School-ID",
            "value": "SCH001"
          },
          {
            "name": "X-Admin-ID",
            "value": "admin001"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"newPassword\": \"newsecurepassword123\",\n  \"confirmPassword\": \"newsecurepassword123\"\n}"
        }
      }
    }
  ]
}