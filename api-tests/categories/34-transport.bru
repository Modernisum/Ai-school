{
  "version": "1",
  "name": "Transport Management APIs",
  "type": "collection",
  "items": [
    {
      "name": "Publish GPS Update",
      "type": "http-request",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/transport/{{schoolId}}/gps/VEH001",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          },
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ],
        "body": {
          "mode": "json",
          "json": {
            "lat": 28.6139,
            "lng": 77.2090,
            "speed": 45.5
          }
        }
      }
    }
  ]
}