{
  "version": "1",
  "name": "School Holidays",
  "type": "collection",
  "items": [
    {
      "name": "List School Holidays",
      "type": "http",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/school-holidays/:schoolId",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ],
        "query": {
          "month": "4",
          "year": "2024"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "success": true,
          "data": [
            {
              "holidayId": "HOL001",
              "title": "Good Friday",
              "description": "Christian holiday",
              "date": "2024-04-07",
              "type": "religious",
              "durationDays": 1,
              "applicableTo": ["students", "teachers", "staff"],
              "createdBy": "admin123",
              "createdAt": "2024-01-15T10:00:00Z"
            },
            {
              "holidayId": "HOL002",
              "title": "Summer Vacation",
              "description": "Annual summer break",
              "startDate": "2024-05-15",
              "endDate": "2024-06-15",
              "type": "annual",
              "durationDays": 32,
              "applicableTo": ["students"],
              "createdBy": "admin456",
              "createdAt": "2024-01-20T14:30:00Z"
            }
          ]
        }
      }
    },
    {
      "name": "Get Holiday Detail",
      "type": "http",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/school-holidays/:schoolId/:holidayId",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "success": true,
          "data": {
            "holidayId": "HOL001",
            "title": "Good Friday",
            "description": "Christian holiday observed by school",
            "date": "2024-04-07",
            "type": "religious",
            "durationDays": 1,
            "applicableTo": ["students", "teachers", "staff"],
            "notes": "School will remain closed",
            "createdBy": "admin123",
            "createdAt": "2024-01-15T10:00:00Z",
            "updatedBy": "admin123",
            "updatedAt": "2024-01-16T11:00:00Z"
          }
        }
      }
    },
    {
      "name": "Create School Holiday",
      "type": "http",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/school-holidays/:schoolId",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          },
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ],
        "body": {
          "mode": "json",
          "json": {
            "title": "Diwali Festival",
            "description": "Hindu festival of lights",
            "date": "2024-11-01",
            "type": "cultural",
            "durationDays": 3,
            "applicableTo": ["students", "teachers", "staff"],
            "notes": "Extended holiday for festival celebrations"
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "success": true,
          "data": {
            "holidayId": "{{$random.uuid}}",
            "title": "Diwali Festival",
            "description": "Hindu festival of lights",
            "date": "2024-11-01",
            "type": "cultural",
            "durationDays": 3,
            "applicableTo": ["students", "teachers", "staff"],
            "createdBy": "{{adminId}}",
            "createdAt": "{{$timestamp.iso}}"
          }
        }
      }
    },
    {
      "name": "Delete School Holiday",
      "type": "http",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/school-holidays/:schoolId/:holidayId",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "success": true
        }
      }
    },
    {
      "name": "Check School Holiday",
      "type": "http",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/school-holidays/:schoolId/check",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ],
        "query": {
          "date": "2024-04-07"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "success": true,
          "isHoliday": true,
          "holiday": {
            "holidayId": "HOL001",
            "title": "Good Friday",
            "description": "Christian holiday",
            "date": "2024-04-07",
            "type": "religious"
          }
        }
      }
    }
  ]
}