{
  "version": "1",
  "name": "Complaint Management APIs",
  "type": "collection",
  "items": [
    {
      "name": "1. Create Complaint",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/complains/{{schoolId}}",
        "method": "POST",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          },
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"title\": \"Classroom AC not working\",\n  \"description\": \"The air conditioner in classroom 101 has been not working for 3 days. Students are facing discomfort during lectures.\",\n  \"category\": \"facilities\",\n  \"priority\": \"medium\",\n  \"reported_by\": {\n    \"id\": \"{{studentId}}\",\n    \"name\": \"Rahul Sharma\",\n    \"role\": \"student\"\n  },\n  \"assigned_to\": {\n    \"id\": \"{{employeeId}}\",\n    \"name\": \"Maintenance Department\",\n    \"role\": \"employee\"\n  },\n  \"status\": \"open\",\n  \"attachment_path\": null\n}"
        }
      }
    },
    {
      "name": "2. List All Complaints",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/complains/{{schoolId}}",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "3. List Complaints with Filters",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/complains/{{schoolId}}?user_id={{studentId}}&user_role=student",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "4. List Complaints by Summary",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/complains/{{schoolId}}/{{complaintSummaryId}}/complainlist",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "5. List Complaints by Student",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/complains/{{schoolId}}/student/{{studentId}}",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    }
  ]
}