{
  "version": "1",
  "name": "Reminder Management APIs",
  "type": "collection",
  "items": [
    {
      "name": "GET /api/reminders/:schoolId - List All Reminders",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/reminders/{{schoolId}}",
        "method": "GET",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          }
        ]
      }
    },
    {
      "name": "POST /api/reminders/:schoolId - Create Reminder",
      "type": "http-request",
      "request": {
        "url": "{{baseUrl}}/api/reminders/{{schoolId}}",
        "method": "POST",
        "headers": [
          {
            "name": "X-School-ID",
            "value": "{{schoolId}}"
          },
          {
            "name": "X-Admin-ID",
            "value": "{{adminId}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "type": "json",
          "raw": "{\n  \"title\": \"Submit Annual Reports\",\n  \"description\": \"All teachers must submit annual reports by Friday\",\n  \"reminder_type\": \"task\",\n  \"priority\": \"high\",\n  \"due_date\": \"2024-03-22\",\n  \"assigned_to\": \"teachers\",\n  \"assigned_to_ids\": [\"teacher_001\", \"teacher_002\"],\n  \"notification_channels\": [\"in_app\", \"email\"],\n  \"repeat_schedule\": \"none\",\n  \"tags\": [\"reports\", \"deadline\", \"academic\"]\n}"
        }
      }
    }
  ]
}