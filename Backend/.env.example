# Database
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/ai_school

# Redis
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@localhost:6379/

# Authentication
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
SUPER_ADMIN_SECRET=CHANGE_ME_TO_ANOTHER_RANDOM_64_CHAR_STRING

# Server
API_BASE_URL=http://localhost:8080
PORT=8080
RUST_LOG=info

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5174,http://localhost:3001

# File uploads
UPLOAD_DIR=./uploads
UPLOAD_TOKEN=CHANGE_ME_RANDOM_TOKEN

# AI Providers (configured via SuperAdmin UI, these are fallbacks)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com
